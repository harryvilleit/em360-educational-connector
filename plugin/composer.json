{
  "name": "harryville/em360-school-connector",
  "description": "EM360 School Connector for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.1", "ext-json": "*", "ext-openssl": "*" },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.1",
    "php-stubs/wordpress-stubs": "~6.8.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": { "psr-4": { "EM360\\SchoolConnector\\": "src/" } },
  "autoload-dev": { "psr-4": { "EM360\\SchoolConnector\\Tests\\": "tests/" } },
  "config": { "sort-packages": true, "allow-plugins": false, "platform": { "php": "8.1.0" } },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "style": "phpcs",
    "check": ["@test", "@analyse", "@style"]
  }
}
